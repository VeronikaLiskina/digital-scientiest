DATABASE_URL=postgresql+asyncpg://postgres:nika@db:5432/digital_scientist
CELERY_BROKER_URL=redis://redis:6379/0
UPLOAD_DIR=uploads
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
# Available comparison model: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=768
RERANKER_MIN_SCORE=0.5
RERANKER_TOP_K=6
PDF_PROCESSING_MAX_RETRIES=3
# Reuse recognized pages between PDF preview and background processing.
PDF_OCR_CACHE_ENABLED=true

# Primary API: groq (current provider) or api (Chat Completions compatible).
LLM_PROVIDER=groq

# Groq provider. Keep the real key only in .env; never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_REASONING_EFFORT=medium

# Future provider: set LLM_PROVIDER=api and fill in these values.
# The base URL must use HTTPS and include the API prefix (usually /v1).
# Choose a model supporting json_schema structured output and json_object mode.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=
LLM_API_TIMEOUT_SECONDS=120
LLM_API_MAX_COMPLETION_TOKENS=4096

# Optional local reserve for the assistant. Requires a running Ollama and an
# already installed model; the application never downloads models itself.
LLM_LOCAL_FALLBACK_ENABLED=true
LLM_FALLBACK_API_TIMEOUT_SECONDS=30
LLM_FALLBACK_COOLDOWN_SECONDS=60
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_THREAD=2
OLLAMA_NUM_BATCH=128
OLLAMA_USE_MMAP=true
