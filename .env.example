DATABASE_URL=postgresql+asyncpg://postgres:nika@db:5432/digital_scientist
CELERY_BROKER_URL=redis://redis:6379/0
UPLOAD_DIR=uploads
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
# Available comparison model: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=768
RERANKER_MIN_SCORE=0.5
RERANKER_TOP_K=6
PDF_PROCESSING_MAX_RETRIES=3

# LLM provider: ollama or groq
LLM_PROVIDER=ollama
HYBRID_FALLBACK_DELAY_SECONDS=10

# Local provider
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false

# Groq provider. Keep the real key only in .env; never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_COMPLETION_TOKENS=1400
GROQ_REASONING_EFFORT=medium
